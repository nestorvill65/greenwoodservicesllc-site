---
import Layout from '../layouts/Layout.astro';
---

<Layout 
  title="About Us | Greenwood Cleaning Services LLC" 
  description="Learn about Greenwood Cleaning Services LLC: family-owned, licensed, insured cleaning company serving Howard County, Maryland."
>
  <main>
    <section class="page-header" style="background: linear-gradient(rgba(0, 0, 0, 0.65), rgba(0, 0, 0, 0.65)), url('/kitchen-bg.png') center/cover; padding: 80px 20px; text-align: center; color: white;">
      <div class="container">
        <h1 style="font-size: 2.5rem; font-weight: 800; text-transform: uppercase;">About Greenwood Cleaning</h1>
        <p style="font-size: 1.1rem; max-width: 650px; margin: 15px auto 0;">Your reliable, local cleaning partner in Howard County, MD.</p>
      </div>
    </section>

    <section style="padding: 70px 20px;">
      <div class="container" style="max-width: 1000px; margin: 0 auto; display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 50px; align-items: center;">
        <div>
          <h2 style="font-size: 2rem; font-weight: 800; color: #1b6b35; margin-bottom: 20px;">Trusted Maid Care Rooted in Columbia, MD</h2>
          <p style="line-height: 1.8; color: #444; margin-bottom: 15px;">
            Greenwood Cleaning Services LLC was established to deliver unmatched thoroughness, punctuality, and trust to Maryland families and busy professionals.
          </p>
          <p style="line-height: 1.8; color: #444; margin-bottom: 20px;">
            We operate fully licensed and insured, using safe, effective supplies and detail-driven checklists so you always come home to a truly refreshed environment.
          </p>
          <a href="/contact" class="btn-cta" style="display: inline-block;">Get in Touch &rarr;</a>
        </div>
        <div>
          <img src="/team.png" alt="Greenwood Cleaning Team" style="width: 100%; border-radius: 12px; box-shadow: 0 10px 25px rgba(0,0,0,0.1);" />
        </div>
      </div>
    </section>
  </main>
</Layout>
