---
import Layout from '../layouts/Layout.astro';
---

<Layout 
  title="Thank You! | Greenwood Cleaning Services LLC"
  description="Thank you for contacting Greenwood Cleaning Services LLC. We will reply within 24 hours."
>
  <main>
    <section class="hero" style="min-height: 60vh; height: auto; padding: 80px 20px;">
      <div class="container hero-text">
        <div style="background: #ffffff; padding: 45px 35px; border-radius: 16px; box-shadow: 0 10px 30px rgba(0,0,0,0.2); max-width: 600px; margin: 0 auto;">
          <i class="fas fa-check-circle" style="color: #28a745; font-size: 4rem; margin-bottom: 20px;"></i>
          <h1 style="color: #333333; font-size: 2.3rem; margin-bottom: 15px; text-shadow: none;">Message Sent!</h1>
          <p style="color: #4b5563; font-size: 1.05rem; margin-bottom: 30px; text-shadow: none; font-weight: 400;">
            Thank you for contacting <strong>Greenwood Cleaning Services LLC</strong>.<br />
            We have received your estimate request and will get back to you within 24 business hours.
          </p>
          <a href="/" class="btn-hero">Return to Home</a>
        </div>
      </div>
    </section>
  </main>
</Layout>

